# JharSetu keeps its environment files next to the app that reads them.
#
#   backend/.env.example   ->  copy to backend/.env.local
#                              Supabase keys, the LLM and speech keys, the SMS
#                              gateway, and the demo secrets. This is the long one.
#
#   frontend/.env.example  ->  copy to frontend/.env.local
#                              the Supabase URL and anon key, plus the backend
#                              origin below.
#
# The frontend and the backend run as separate apps, so the UI needs to know
# where the API is. In development the backend listens on port 3001.
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Speech to text  (Whisper large-v3 on Groq)
# ---------------------------------------------------------------------------
# PASTE YOUR GROQ KEY HERE. Until this is set, /api/health reports
# speech_to_text: false, the microphone on /report still records and uploads,
# but the server answers "Speech to text unavailable" and files the report with
# a placeholder brief instead of the spoken words.
#
# Get one at https://console.groq.com/keys  (free tier covers a demo)
# It must ALSO be set on the deployed backend, or the live site is unaffected:
#   cd backend && npx vercel env add GROQ_API_KEY production
#   (repeat for preview and development, then redeploy)
GROQ_API_KEY=
