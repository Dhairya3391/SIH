# ─── JharSetu / SIH — .gitignore ───

# Env & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js

# Next.js
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.next/cache/
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Supabase
supabase/.branches
supabase/.temp
supabase/config.toml.bak

# Vercel
.vercel
frontend/.vercel

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing / coverage
coverage/
.nyc_output/
*.lcov
.test-results/
playwright-report/
playwright/.cache/

# Misc build caches
.turbo
.eslintcache
.stylelintcache
.parcel-cache/
.cache/

# Uploads / media (local only — seeded media lives in backend/supabase/seed)
uploads/
*.mp4
*.mov
!presentation/demo/backup-*.mp4

# SMS gateway local state / phones
*.har

# Python (scripts / seed helpers)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Scripts cache
/scripts/.cache/
