# ---------------------------------------------------------------------------
# Supabase Connection Variables
# Required for live Postgres database.
# (If omitted, JharSetu can run on high-fidelity seeded in-memory data)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler / direct connection string, used only by the migration script.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# LLM  (every call goes through lib/ai/llm.ts, so the provider swaps in one place)
# Provider is Gemini (free tier): briefs via gemini-3.6-flash, embeddings via
# gemini-embedding-001 truncated to 768 dims to match the vector(768) columns.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL_FAST=gemini-3.6-flash
LLM_MODEL_DRAFT=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Speech to text  (Whisper large-v3 on Groq)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# SMS gateway  (the spare Android phone running SMS Gateway for Android)
# ---------------------------------------------------------------------------
SMS_INBOUND_SECRET=change-me-before-the-hackathon
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
JHARSETU_SMS_NUMBER=

# ---------------------------------------------------------------------------
# Cross-origin access
# ---------------------------------------------------------------------------
# The UI is a separate app on port 3000, so the API has to name its origin.
# localhost:3000 and 127.0.0.1:3000 are allowed automatically in development.
# Add the deployed frontend URL here, comma-separated, before going live.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Demo controls
# ---------------------------------------------------------------------------
DEMO_RESET_SECRET=change-me-before-the-hackathon
# The one-click role switcher signs into six seeded accounts. Without this the
# switcher is disabled and the seed script creates no accounts.
DEMO_PASSWORD=
DEMO_EMAIL_DOMAIN=jharsetu.demo
DEFAULT_REGION_ID=jharkhand
# Set to false to run the whole platform on its rule-based fallbacks.
AI_ENABLED=true
