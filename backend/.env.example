# ===========================================================================
# JharSetu backend environment
# ===========================================================================
# Copy to .env.local and fill in. .env* is gitignored.
#
# Nothing here is required for the platform to run: every integration degrades
# to a stated fallback rather than failing. What each missing key costs is
# written above it, so you can decide what is worth getting.
#
# To check what is live on a deployment:  GET /api/health
# ===========================================================================


# ---------------------------------------------------------------------------
# Supabase  (REQUIRED - nothing works without these)
# ---------------------------------------------------------------------------
# Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The POSTGRES connection string, used ONLY by scripts/db-push.ts and the seed.
# Not read at runtime, so it never needs to go on Vercel.
#
# Dashboard -> Settings -> Database -> Connection string -> URI
# USE THE SESSION POOLER (port 5432). Two traps:
#   - the direct host db.<ref>.supabase.co does not resolve over IPv4 on newer
#     projects; the pooler host does
#   - the transaction pooler on 6543 refuses the DDL these migrations run
# The pooler username is postgres.<project-ref>, not postgres.
# Percent-encode @ # / : ? in the password (@ -> %40).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres


# ---------------------------------------------------------------------------
# Gemini  (the compiler, the proposal scorer, the corroboration synthesis)
# ---------------------------------------------------------------------------
# WITHOUT THIS: intake still works on the rule-based compiler, but proposals
# cannot be scored and corroboration cannot reach a verdict.
#
# Get a key:  https://aistudio.google.com/apikey
#
# Up to ten keys rotate, which is how the free tier survives a demo. Use
# either form:
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# The cascade, tried in order until one answers. Leave unset for the default.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Set to false to run the whole platform on its rule-based fallbacks.
AI_ENABLED=true


# ---------------------------------------------------------------------------
# Speech to text  (Whisper large-v3 on Groq)
# ---------------------------------------------------------------------------
# WITHOUT THIS: the microphone on /report still records and uploads, but the
# server refuses the report with "Speech to text is not configured" rather
# than filing a blank one. /api/health reports speech_to_text: false.
#
# Get a key:  https://console.groq.com/keys
# Free tier, no card. Sign in with Google, then "Create API Key".
GROQ_API_KEY=


# ---------------------------------------------------------------------------
# JharSetu's own trained models  (ml/serve.py sidecar) - optional
# ---------------------------------------------------------------------------
# WITHOUT THIS: the classifier still runs, in TypeScript, from the weights in
# lib/ai/models/report-classifier.json. This variable adds the bigger
# transformer classifier and our Whisper fine-tune for rural Hindi, which are
# too large for a serverless function. Every call fails soft: if the sidecar is
# down, the in-process model answers, then the keyword rules.
#
#   python ml/serve.py        (see ml/README.md, measurements in ml/RESULTS.md)
ML_SERVICE_URL=
# ML_SERVICE_TIMEOUT_MS=4000

# Use our dedup embeddings instead of Gemini's. CAUTION: a different vector
# space, so run `npm run db:reset` after switching or old rows stop matching.
ML_EMBEDDINGS=false


# ---------------------------------------------------------------------------
# News  (external corroboration, provider 2 of 3)
# ---------------------------------------------------------------------------
# WITHOUT THIS: corroboration still runs on weather and web, and records
# "NEWS_API_KEY is not set on this deployment" as a provider error - which is
# deliberately distinct from "found nothing".
#
# Get a key:  https://newsapi.org/register
# Free developer tier: 100 requests/day, and articles are delayed 24h, which
# is fine for corroborating something that happened yesterday.
#
# Alternatives if you prefer better Indian regional coverage:
#   https://gnews.io/                 (free tier, 100/day)
#   https://newsdata.io/register      (free tier, 200/day, good Hindi coverage)
# Swapping provider means editing one adapter in lib/ai/corroborate.ts.
NEWS_API_KEY=


# ---------------------------------------------------------------------------
# Web search  (external corroboration, provider 3 of 3)
# ---------------------------------------------------------------------------
# WITHOUT THIS: corroboration runs on weather and news only. This is the
# provider that catches the district administration notice and the NDRF
# sitrep that no news API indexes.
#
# Get a key:  https://app.tavily.com/home
# Free tier: 1000 searches/month, no card. The adapter is written for
# Tavily's response shape.
#
# Alternatives:
#   https://serper.dev/            (free 2500 queries, Google results)
#   https://brave.com/search/api/  (free 2000/month)
SEARCH_API_KEY=


# ---------------------------------------------------------------------------
# Weather  (external corroboration, provider 1 of 3)
# ---------------------------------------------------------------------------
# NO KEY NEEDED. Open-Meteo's historical archive is free and unauthenticated,
# which is why corroboration partly works on a fresh deployment.
# https://open-meteo.com/en/docs/historical-weather-api


# ---------------------------------------------------------------------------
# SMS gateway  (the spare Android phone running SMS Gateway for Android)
# ---------------------------------------------------------------------------
# WITHOUT THESE: inbound coded SMS still parses if something posts to
# /api/sms/inbound, but nothing can be sent out.
# https://github.com/capcom6/android-sms-gateway
SMS_INBOUND_SECRET=change-me-before-the-demo
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
JHARSETU_SMS_NUMBER=


# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Authenticates /api/cron/tick, which scores queued proposals and closes
# windows whose time is up. Falls back to DEMO_RESET_SECRET if unset.
# Any long random string.
CRON_SECRET=


# ---------------------------------------------------------------------------
# Cross-origin access
# ---------------------------------------------------------------------------
# The frontend proxies /api/* from its own origin, so this is only needed if
# something calls the API cross-origin. Comma-separated.
CORS_ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------
# Demo controls
# ---------------------------------------------------------------------------
# DEMO_PASSWORD enables the one-click role switcher and the six seeded
# accounts. Without it the switcher is disabled and real sign-in still works.
DEMO_PASSWORD=
DEMO_EMAIL_DOMAIN=jharsetu.demo
DEMO_RESET_SECRET=change-me-before-the-demo
DEFAULT_REGION_ID=jharkhand
