# Supabase Connection Variables
# Required for live Postgres database.
# (If omitted, JharSetu automatically runs on high-fidelity seeded in-memory data for instant demo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend origin proxied via next.config.ts rewrites (/api/* -> BACKEND_ORIGIN/api/*).
# In development the backend listens on port 3001.
# In production (Vercel project `sih`) this must be the deployed backend URL:
#   BACKEND_ORIGIN=https://jharsetu-demo-api.vercel.app
BACKEND_ORIGIN=http://localhost:3001
