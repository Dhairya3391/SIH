[{"text": "kal aandhi paani me tola ka ek ped bijli ke taar pe gir gaya, poora mohalla andhere me aur taar sadak pe pada", "category": [0.379374, 0.0429, 0.000717, 0.002445, 0.001098, 0.040372, 0.521997, 0.011098], "severity": [1.8e-05, 0.002523, 0.046608, 0.84684, 0.104011], "dm_phase": [0.036109, 0.021422, 0.94202, 0.000448]}, {"text": "Dumka Jarmundi - pichhle hafte se har raat baadal garajte hi log dar jaate hai, bajrang tola me 3 maut ho chuki is saal", "category": [0.19385, 0.039406, 0.12443, 0.096393, 0.091196, 0.170199, 0.064246, 0.22028], "severity": [0.002231, 0.031627, 0.231616, 0.701878, 0.032648], "dm_phase": [0.859229, 0.099988, 0.025726, 0.015056]}, {"text": "हमारे पंचायत में कोई भी आपदा मित्र ट्रेनिंग नहीं हुई, बाढ़ आए तो कोई तैरना नहीं जानता", "category": [0.797109, 0.017255, 0.013155, 0.059452, 0.061691, 0.006017, 0.0207, 0.024621], "severity": [0.008325, 0.273336, 0.620657, 0.095488, 0.002194], "dm_phase": [0.486139, 0.09979, 0.386466, 0.027606]}, {"text": "the relief camp has 400 people but only two toilets and women are scared to go at night", "category": [0.041023, 0.061907, 0.009542, 0.79933, 0.012327, 0.006259, 0.054028, 0.015584], "severity": [0.000881, 0.064737, 0.733549, 0.189303, 0.01153], "dm_phase": [0.275623, 0.031438, 0.264147, 0.428792]}, {"text": "bijli girne se school ka ek bachcha behosh, baaki bachche dar ke maare school nahi aa rahe", "category": [0.648232, 0.004123, 0.017671, 0.071759, 0.002112, 0.030967, 0.187527, 0.03761], "severity": [0.002539, 0.145833, 0.313064, 0.259784, 0.27878], "dm_phase": [0.57121, 0.356982, 0.065468, 0.006339]}, {"text": "rail line ke kinare ki jhopdiyan paani me, 70 log platform pe raat bita rahe", "category": [0.21467, 0.36067, 0.039636, 0.007314, 0.008654, 0.038374, 0.048262, 0.28242], "severity": [0.00068, 0.01174, 0.853179, 0.132651, 0.001749], "dm_phase": [0.949699, 0.010161, 0.039415, 0.000725]}, {"text": "boring ka paani khara ho gaya hai, dal bhi nahi galti", "category": [0.038915, 0.872445,