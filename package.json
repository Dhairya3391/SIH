{
  "name": "jharsetu-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "JharSetu (SIH26043). frontend/ is the citizen and coordinator UI, backend/ is the API, Compiler and database.",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "smoke": "npm --prefix backend run smoke"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  }
}
